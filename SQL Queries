
##Revenue 2015
WITH Revenue AS(
	SELECT 
	s15.* , p.ProductPrice 
	FROM AdventureWorks_Sales_2015 AS s15 
	JOIN AdventureWorks_Products AS p
	ON s15.ProductKey = p.ProductKey )
		SELECT SUM(ProductPrice * OrderQuantity)As Revenue_2015 FROM Revenue;
		
		
